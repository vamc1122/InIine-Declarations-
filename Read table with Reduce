DATA(matched_record) = REDUCE ty_wbsegbkpf(
  INIT result = VALUE ty_wbsegbkpf( )
  FOR wa IN it_wbsegbkpf
  NEXT result = COND #(
    WHEN wa-gjahr = wa_finalref-gjahr AND
         wa-bldat = wa_finalref-doc_date AND
         wa-bschl = wa_finalref-post_key AND
         wa-lifnr = wa_finalref-lifnr AND
         wa-bukrs = wa_finalref-bukrs AND
         wa-waers = wa_finalref-curr AND
         lv_dmbtr = wa-dmbtr + wa-qbshb
    THEN wa
    ELSE result ) ).

